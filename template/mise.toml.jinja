# Tools only. Tasks are script files, one per task, in two folders mise loads
# together:
#
#   mise-tasks/     the shared toolkit and meta-repo tasks, kept current by
#                   template updates (harbor sync); don't edit them here
#   .mise/tasks/    this repo's own tasks; a same-named task here overrides one
#                   from mise-tasks/
#
#   mise run sync       clone sub-repos
#   mise run tilt:up    every task as a button in this repo's Tilt dashboard
#   mise run env        every value tasks see, and where it comes from
#   mise tasks          list everything
#
# Cross-repo tasks (run inside each sub-repo) stay in mani.yaml, so they keep
# mani's targeting and parallelism: `mani run <task> --all --parallel`.

[tools]
mani = "latest"
tilt = "latest"
{%- if use_fnox %}
fnox = "latest"
{%- endif %}
