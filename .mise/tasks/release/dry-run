#!/usr/bin/env bash
#MISE description="Run the release workflow locally in Docker with act: version, changelog and build only; publishes nothing"
set -euo pipefail
DOCKER_HOST=$("$MISE_PROJECT_ROOT/.mise/tasks/.lib/docker-host") || exit 1
export DOCKER_HOST
exec act workflow_dispatch --workflows .github/workflows/release.yml --input dry_run=true
