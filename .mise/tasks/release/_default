#!/usr/bin/env bash
#MISE description="Publish the next date version: needs an entry under ## [Unreleased] in CHANGELOG.md, pushed"
set -euo pipefail
if [ -n "$(git status --porcelain)" ] || [ "$(git rev-parse HEAD)" != "$(git rev-parse @{u})" ]; then
  echo "Commit and push first: the release is built from what's on GitHub." >&2
  exit 1
fi
gh workflow run release.yml
sleep 3
gh run watch "$(gh run list --workflow release.yml --limit 1 --json databaseId --jq '.[0].databaseId')" --exit-status
git pull --quiet
mise run dev
