#!/usr/bin/env bash
#MISE description="Install this checkout as an editable uv tool: the released package and commands, running your code"
#TILT deps=pyproject.toml,uv.lock
set -euo pipefail
name=$(sed -n 's/^name = "\(.*\)"$/\1/p' pyproject.toml | head -1)
uv tool install --editable . --force --reinstall-package "$name" --quiet  # rebuild, so the version is current
echo "Installed $name from $PWD (editable)"
uv tool list | awk -v n="$name" '$1 == n {p=1; print; next} p && /^- / {print; next} {p=0}'
echo
echo "Code changes apply on the next run. Run 'mise run dev' again after a release,"
echo "a pull, or a dependency change, to refresh the version and dependencies."
